# Real Firebase Web App config — copy to `.env.local` and fill in values from
# Firebase Console → Project settings → Your apps → Web app.
# Never commit real secrets. Never use emulator placeholders.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public app URL used in email links (local or production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend transactional email (server-only) ---
# Create an API key at https://resend.com — never use NEXT_PUBLIC_ for this.
RESEND_API_KEY=
# Example production sender after DNS is verified:
# EMAIL_FROM=TeamSplit <notifications@teamsplit.vanaku.com>
EMAIL_FROM=TeamSplit <onboarding@resend.dev>

# Shared secret for /api/cron/notifications (Vercel Cron Authorization header).
CRON_SECRET=

# Optional: allow Admin "Simulate" in non-development deployments (never enable in prod casually).
# ALLOW_NOTIFICATION_SIMULATE=true

# --- Optional: player/evaluation import (Admin SDK) ---
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json
# CONFIRM_FIRESTORE_SEED=true
# Or inline JSON for Vercel:
# FIREBASE_SERVICE_ACCOUNT_JSON=
